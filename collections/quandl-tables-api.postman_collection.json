  "info": {
    "_postman_id": "845fcc5c-8fa8-4032-bcfb-37e27b2102c8",
    "name": "Nasdaq Data Link Time-Series REST Databases Tables API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Nasdaq Data Link REST API (formerly Quandl) provides access to financial and economic time-series datasets including stock prices, economic indicators, interest rates, and commodity data in JSON, XML, and CSV formats. Authenticated users receive up to 50,000 API calls per day.\n\nContact Support:\n Name: Nasdaq Data Link Support",
      "type": "text/plain"
    }
  }
