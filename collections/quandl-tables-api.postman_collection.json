      },
      "item": [
        {
          "id": "e3117968-93cc-4f8c-825b-abbd85ca06b7",
          "name": "Query a datatable",
          "request": {
            "name": "Query a datatable",
            "description": {
              "content": "Returns rows from a Nasdaq Data Link datatable (tabular dataset). Supports row-level filtering, column selection, and pagination using cursor-based pagination. Maximum 10,000 rows per call.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "datatables",
                ":datatablesCode"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "qopts.columns",
                  "value": "<string>",
                  "description": "Comma-separated column names to return"
                },
                {
                  "disabled": false,
                  "key": "qopts.per_page",
                  "value": "100",
                  "description": "Number of rows per page (max 10000)"
                },
                {
                  "disabled": false,
                  "key": "qopts.cursor_id",
                  "value": "<string>",
                  "description": "Cursor ID for pagination from previous response"
                },
                {
                  "disabled": false,
                  "key": "qopts.export",
                  "value": "<boolean>",
                  "description": "Set to true to get a download link for full dataset"
                },
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "datatablesCode",
                  "description": "(Required) Database code and datatable code joined by slash (e.g. ZACKS/FC)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
