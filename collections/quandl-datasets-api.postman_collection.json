        "type": "text/plain"
      },
      "item": [
        {
          "id": "16312eb0-a064-4229-b647-4cc1d1bc0c6c",
          "name": "Get a time-series dataset",
          "request": {
            "name": "Get a time-series dataset",
            "description": {
              "content": "Returns time-series data from a Nasdaq Data Link dataset. Supports date range filtering, column selection, frequency transformation, and return type selection (JSON, XML, CSV).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "datasets",
                ":databaseCode",
                ":datasetCode"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Number of rows to return (0 returns all)"
                },
                {
                  "disabled": false,
                  "key": "column_index",
                  "value": "<integer>",
                  "description": "Request a specific column (1-based index)"
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<date>",
                  "description": "Retrieve data rows on and after this date (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<date>",
                  "description": "Retrieve data rows up to and including this date (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "order",
                  "value": "desc",
                  "description": "Return data in ascending or descending date order"
                },
                {
                  "disabled": false,
                  "key": "collapse",
                  "value": "none",
                  "description": "Frequency to collapse data to"
                },
                {
                  "disabled": false,
                  "key": "transform",
                  "value": "none",
                  "description": "Mathematical transformation to apply to values"
                },
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "Your Nasdaq Data Link API key"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "databaseCode",
                  "description": "(Required) Database code (e.g., FRED, WIKI, CHRIS, BCOM)"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "datasetCode",
                  "description": "(Required) Dataset code within the database (e.g., GDP, AAPL)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
